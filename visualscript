connect(RunService.Heartbeat,protect("Frame update",function(dt)
    if not alive then return end
    advanceGuide(dt)
    if not initialized then
        initialized=true
        if loading.Parent then loading:Destroy() end
        notify("Welcome to winter","SOLARA is ready. Open UNIT MANAGER to build your strategy.")
    end
    lastMaintenance+=dt
    if lastMaintenance>=0.5 then
        lastMaintenance=0; updateHome()
        if logsDirty and currentPage=="LOGS" and root.Visible then refreshLogs() end
        local now=os.clock()
        for i=#toastRecords,1,-1 do
            local t=toastRecords[i]
            if not t.Parent or now>=(t:GetAttribute("Expires") or now) then
                if t.Parent then t:Destroy() end; table.remove(toastRecords,i)
            end
        end
        -- UI destruction disconnects its events; discard their Lua references.
        for c in pairs(connections) do if not c.Connected then connections[c]=nil end end
        for i=#themeBindings,1,-1 do if not themeBindings[i].item.Parent then table.remove(themeBindings,i) end end
        for i=#surfaceBindings,1,-1 do if not surfaceBindings[i].item.Parent then table.remove(surfaceBindings,i) end end
        for i=#gradientBindings,1,-1 do if not gradientBindings[i].gradient.Parent then table.remove(gradientBindings,i) end end
    end
end))

