end
local actionKinds = {hint = true, wait = true, marker = true, clearMarkers = true}
local function validateAction(a)
    allowedKeys(a, {kind=true, message=true, delay=true, x=true, y=true, z=true}, "Action")
    assert(actionKinds[a.kind], "Unsupported action kind")
    text(a.message, 240, "Action message", a.kind ~= "hint")
    number(a.delay, 0, 600, "Action delay")
    for _, key in ipairs({"x", "y", "z"}) do number(a[key], -1000000, 1000000, "Action " .. key) end
end
local function validateUnit(u)
    allowedKeys(u, {name=true, slot=true, x=true, y=true, z=true, placementPriority=true, upgradePriority=true, maxUpgrade=true, delay=true}, "Unit")
    text(u.name, 60, "Unit name", false)
    number(u.slot, 1, 12, "Slot", true)
    for _, key in ipairs({"x", "y", "z"}) do number(u[key], -1000000, 1000000, "Unit " .. key) end
    number(u.placementPriority, 1, 100, "Placement priority", true)
    number(u.upgradePriority, 1, 100, "Upgrade priority", true)
    number(u.maxUpgrade, 0, 30, "Planned upgrade count", true)
    number(u.delay, 0, 600, "Placement delay")
end
function validateConfig(c)
    allowedKeys(c, {version=true, settings=true, units=true, actions=true}, "Configuration")
    assert(c.version == 1, "Unsupported configuration version")
    local s = c.settings
    assert(type(s)=="table", "Settings must be an object")
    -- Version 1.0 exports remain valid; the new flow setting defaults to on.
    if s.paletteMotion==nil then c=copy(c); c.settings.paletteMotion=true; s=c.settings end
    allowedKeys(s, {uiScale=true, theme=true, animations=true, snow=true, lights=true, paletteMotion=true, toggleKey=true, stopKey=true, autoSave=true}, "Settings")
    number(s.uiScale, 0.75, 1.4, "UI scale")
    assert(THEMES[s.theme], "Unknown winter theme")
    for _, key in ipairs({"animations", "snow", "lights", "paletteMotion", "autoSave"}) do assert(type(s[key]) == "boolean", key .. " must be boolean") end
    keyName(s.toggleKey); keyName(s.stopKey)
    assert(s.toggleKey ~= s.stopKey, "Show/hide and stop hotkeys must differ")
    array(c.units, 50, "Units"); for _, u in ipairs(c.units) do validateUnit(u) end
    array(c.actions, 300, "Actions"); for _, a in ipairs(c.actions) do validateAction(a) end
    local normalized=copy(c)
    -- Accept legacy JSON fields without restoring the removed visual effects.
    for _,key in ipairs({"animations","snow","lights","paletteMotion"}) do normalized.settings[key]=false end
    return normalized
end

