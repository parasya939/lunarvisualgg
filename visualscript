local function allowedKeys(t, names, label)
    assert(type(t) == "table", label .. " must be an object")
    for k in pairs(t) do assert(names[k], label .. ": unknown field " .. tostring(k)) end
end
local function number(n, a, b, label, integer)
    assert(finite(n) and n >= a and n <= b and (not integer or n % 1 == 0), label .. " must be " .. a .. ".." .. b)
    return n
end
local function text(s, limit, label, allowEmpty)
    assert(type(s) == "string" and #s <= limit and (allowEmpty or #trim(s) > 0), label .. " is invalid or too long")
    assert(not s:find("[%z\1-\8\11\12\14-\31]"), label .. " contains control characters")
    return s
end
local function array(t, maximum, label)
    assert(type(t) == "table" and #t <= maximum, label .. " exceeds " .. maximum .. " entries")
    local count = 0
    for k in pairs(t) do assert(type(k) == "number" and k % 1 == 0 and k >= 1 and k <= #t, label .. " must be an array"); count += 1 end
    assert(count == #t, label .. " has missing entries")
end
local forbiddenKeys = {Unknown = true, Escape = true, Return = true, Backspace = true}
local function keyName(name)
    assert(type(name) == "string" and #name <= 30 and not forbiddenKeys[name], "Invalid hotkey")
    local ok, item = pcall(function() return Enum.KeyCode[name] end)
    assert(ok and item and item.EnumType == Enum.KeyCode, "Unknown hotkey: " .. tostring(name))
