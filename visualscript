local engine={state="idle",index=0,total=0,elapsed=0,remaining=0,lastAction="No actions executed",run=nil,completed=0}
local function stopGuide(reason)
    local wasRunning=engine.state=="running" or engine.state=="paused"
    engine.state="idle"; engine.run=nil; engine.remaining=0; engine.index=0; engine.total=0
    clearMarkers()
    if wasRunning then log("GUIDE",reason or "Guide stopped; all pending actions cancelled") end
    if updateHome then updateHome() end
end
local function pauseGuide()
    if engine.state~="running" then notify("Nothing to pause","Start a guide first."); return end
    engine.state="paused"; log("GUIDE","Guide paused; countdown frozen")
    if updateHome then updateHome() end
end
local function resumeGuide()
    if engine.state~="paused" then notify("Nothing to resume","The guide is not paused."); return end
    engine.state="running"; log("GUIDE","Guide resumed")
    if updateHome then updateHome() end
end
local function startGuide()
    assert(engine.state~="running" and engine.state~="paused","A guide is already active; stop it before starting another")
    validateConfig(config)
    assert(#config.actions>0,"Add at least one action in MACRO")
    clearMarkers()
    engine.run=copy(config.actions); engine.index=1; engine.total=#engine.run; engine.remaining=engine.run[1].delay
    engine.elapsed=0; engine.state="running"; log("GUIDE","Started local guide with "..engine.total.." actions")
    notify("Guide started","Only reminders and local markers are executed.")
    if updateHome then updateHome() end
end
local function executeAction(a)
    if a.kind=="hint" then notify("Strategy reminder",a.message); engine.lastAction=a.message
    elseif a.kind=="marker" then addMarker(Vector3.new(a.x,a.y,a.z),a.message~="" and a.message or "Planned position"); engine.lastAction="Placed local marker: "..a.message
    elseif a.kind=="wait" then engine.lastAction=a.message~="" and a.message or "Wait completed"
    elseif a.kind=="clearMarkers" then clearMarkers(); engine.lastAction="Cleared local markers"
    else error("Unsupported action kind") end
    log("ACTION",tostring(engine.index).."/"..engine.total.." · "..a.kind.." · "..engine.lastAction)
end
local function advanceGuide(dt)
    if engine.state~="running" or not engine.run then return end
    engine.elapsed+=dt; engine.remaining-=dt
    local count=0
    while engine.state=="running" and engine.remaining<=0 and count<12 do
        count+=1
        local a=engine.run[engine.index]
        local ok,err=xpcall(function() executeAction(a) end,debug.traceback)
        if not ok then stopGuide("Guide stopped after an action error"); log("ERROR",err); notify("Guide error","Execution stopped. See LOGS.","error"); return end
        engine.index+=1
        if engine.index>engine.total then
            engine.state="completed"; engine.completed+=1; engine.run=nil; engine.remaining=0
            log("GUIDE","Local guide completed (not a completed game match)")
            notify("Guide complete","All planned reminders and markers were executed.")
            if updateHome then updateHome() end
            return
        end
        engine.remaining+=engine.run[engine.index].delay
    end
end

