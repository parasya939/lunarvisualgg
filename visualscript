local cameraConnection=nil
local drag=nil
local compact=false
local function viewport()
    local camera=Workspace.CurrentCamera
    local full=camera and camera.ViewportSize or Vector2.new(1280,720)
    local insetA,insetB=game:GetService("GuiService"):GetGuiInset()
    return Vector2.new(math.max(200,full.X-insetA.X-insetB.X),math.max(200,full.Y-insetA.Y-insetB.Y))
end
local function fitPosition()
    local vp=viewport(); local size=root.AbsoluteSize
    local cx=root.Position.X.Scale*vp.X+root.Position.X.Offset
    local cy=root.Position.Y.Scale*vp.Y+root.Position.Y.Offset
    local x=clamp(cx,size.X/2+6,math.max(size.X/2+6,vp.X-size.X/2-6))
    local y=clamp(cy,size.Y/2+6,math.max(size.Y/2+6,vp.Y-size.Y/2-6))
    root.Position=UDim2.fromOffset(x,y)
end
function resize()
    local vp=viewport()
    local desired=config.settings.uiScale
    local w=clamp(vp.X/desired-32,620,1000)
    local h=clamp(vp.Y/desired-32,440,690)
    local effective=math.min(desired,(vp.X-20)/w,(vp.Y-20)/h)
    uiScale.Scale=math.max(0.2,effective)
    root.Size=UDim2.fromOffset(w,minimized and 64 or h)
    content.Visible=not minimized
    compact=vp.X<740
    sidebar.Visible=not compact
    pageHost.Position=UDim2.fromOffset(compact and 18 or 216,20)
    pageHost.Size=UDim2.new(1,compact and -36 or -238,1,-40)
    statePill.Visible=not compact
    fitPosition()
end
function applyTheme()
    local selected=THEMES[config.settings.theme]
    for role,color in pairs(selected.surfaces) do C[role]=color end
    for i=#surfaceBindings,1,-1 do
        local binding=surfaceBindings[i]
        if binding.item.Parent then binding.item[binding.property]=C[binding.role]
        else table.remove(surfaceBindings,i) end
    end
    for i=#themeBindings,1,-1 do
        local b=themeBindings[i]
        if b.item.Parent then b.item[b.property]=THEMES[config.settings.theme][b.secondary and "secondary" or "accent"]
        else table.remove(themeBindings,i) end
    end
    setHeroGradient(); updatePalette(paletteClock); switchPage(currentPage)
    for _,anchor in ipairs(markers) do
        if anchor.Parent then
            for _,obj in ipairs(anchor:GetDescendants()) do
                if obj:IsA("TextLabel") then obj.TextColor3=THEMES[config.settings.theme].accent
                elseif obj:IsA("UIStroke") then obj.Color=THEMES[config.settings.theme].accent end
            end
        end
    end
end
function refreshAll()
    applyTheme(); refreshUnits(); refreshActions(); refreshSettings(); refreshProfiles(); refreshLogs(); updateHome(); resize()
end
