-- 9 · ANIMATION DRIVER
-- ============================================================================
local clockStart = os.clock()

RunService.Heartbeat:Connect(function(delta)
	local t = os.clock() - clockStart

	if math.random() < 0.07 then
		spawnMote()
	end

	-- twinkling stars
	for _, star in ipairs(stars) do
		local flicker = (math.sin(t * star.rate + star.phase) + 1) / 2
		star.frame.BackgroundTransparency = math.clamp(star.base - flicker * 0.35, 0, 1)
	end

	-- aurora sheets breathing and sliding
	for _, aurora in ipairs(auroras) do
		local wave = math.sin(t * aurora.spec.drift * 3 + aurora.phase)
		aurora.frame.Position = UDim2.fromScale(0.5 + wave * 0.09, aurora.spec.y)
		aurora.frame.BackgroundTransparency = aurora.spec.alpha - wave * 0.05
		aurora.frame.Rotation = aurora.frame.Rotation + aurora.spec.drift * delta * 8
	end

	-- rotating rings and border gradients
	for _, ring in ipairs(rings) do
		ring.gradient.Rotation = (ring.gradient.Rotation + ring.speed * delta) % 360
	end

	baseGradient.Rotation = (baseGradient.Rotation + delta * 3) % 360
	panelStrokeGradient.Rotation = (panelStrokeGradient.Rotation + delta * 34) % 360
	avatarStrokeGradient.Rotation = (avatarStrokeGradient.Rotation + delta * 58) % 360
	orbitGradient.Rotation = (orbitGradient.Rotation - delta * 40) % 360
	wordmarkGradient.Offset = Vector2.new((t * 0.22) % 2 - 1, 0)

	-- halo pulse
	local pulse = (math.sin(t * 1.6) + 1) / 2
	halo.BackgroundTransparency = 0.86 + pulse * 0.09
	halo.Size = UDim2.fromOffset(450 + pulse * 46, 450 + pulse * 46)

	-- satellite riding the orbit
	local angle = t * 1.15
	satellite.Position = UDim2.fromScale(
		0.5 + math.cos(angle) * 0.5,
		0.5 + math.sin(angle) * 0.5
	)

	-- breathing strokes
	local breathe = (math.sin(t * 2.4) + 1) / 2
	orbitStroke.Transparency = 0.45 + breathe * 0.3
	panelStroke.Transparency = 0.24 + breathe * 0.22
	barTip.BackgroundTransparency = 0.3 + breathe * 0.35
end)

