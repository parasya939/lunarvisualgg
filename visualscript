	"Bypassing security network checks...",
	"Injecting operational system logic...",
	"Finalizing execution environment...",
}

local TARGET_TIME = 105
local startTime = os.time()

local function setFill(progress, duration)
	tween(barFill, duration, { Size = UDim2.new(progress, 0, 1, 0) },
		Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	barTip.Visible = progress > 0.01
	tween(barTip, duration, { Position = UDim2.new(progress, 0, 0.5, 0) },
		Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
end

while true do
	local elapsed = os.time() - startTime
	local progress = math.clamp(elapsed / TARGET_TIME, 0, 1)
	local percent = math.floor(progress * 100)

	if percent >= 98 then
		setFill(0.98, 0.3)
		percentLabel.Text = "98%"
		break
	end

	setFill(progress, 0.5)
	percentLabel.Text = percent .. "%"

	if percent < 20 then
		statusLabel.Text = phrases[1]
	elseif percent < 45 then
		statusLabel.Text = phrases[2]
	elseif percent < 65 then
		statusLabel.Text = phrases[3]
	elseif percent < 85 then
		statusLabel.Text = phrases[4]
	else
		statusLabel.Text = phrases[5]
	end

	task.wait(0.5)
end

