end
local function button(parent, value, position, dimensions, fn, kind)
    local b = make("TextButton", {Text=value, TextSize=13, Font=Enum.Font.GothamMedium, AutoButtonColor=false,
        TextColor3=C.text, BackgroundColor3=kind=="danger" and Color3.fromRGB(125,43,65) or C.card,
