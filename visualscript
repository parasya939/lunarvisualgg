local C = {bg=Color3.fromRGB(17,24,40), panel=Color3.fromRGB(24,35,55), card=Color3.fromRGB(38,53,77),
    line=Color3.fromRGB(81,108,145), text=Color3.fromRGB(244,248,255), muted=Color3.fromRGB(162,187,215),
    success=Color3.fromRGB(137,245,195), error=Color3.fromRGB(255,125,147)}
local themeBindings = {}
local surfaceBindings = {}
local gradientBindings = {}
local paletteClock = 0
registerSurface=function(item,props)
    for _,property in ipairs({"BackgroundColor3","TextColor3","PlaceholderColor3","Color","ScrollBarImageColor3"}) do
        local value=props[property]
        if typeof(value)=="Color3" then
            for _,role in ipairs({"bg","panel","card","line","text","muted","success","error"}) do
                if value==C[role] then surfaceBindings[#surfaceBindings+1]={item=item,property=property,role=role}; break end
            end
        end
    end
end
local function paletteColor(phase)
    local colors=THEMES[config.settings.theme].colors
    local scaled=(phase%1)*#colors
    local index=math.floor(scaled)+1
    return colors[index]:Lerp(colors[index%#colors+1],scaled%1)
end
local function paletteSequence(mode,phase)
    local points={}
    for i=0,4 do
        local color=paletteColor(phase+i*0.16)
        if mode=="panel" then color=C.card:Lerp(color,0.32+i*0.018)
        elseif mode=="shell" then color=C.bg:Lerp(color,0.025+i*0.006)
        elseif mode=="hero" then color=C.panel:Lerp(color,0.20+i*0.03)
        elseif mode=="subtle" then color=C.panel:Lerp(color,0.10) end
        points[#points+1]=ColorSequenceKeypoint.new(i/4,color)
    end
    return ColorSequence.new(points)
end
local function winterGradient(item,mode,phase)
    assert(not item:IsA("TextButton") and not item:IsA("TextLabel") and not item:IsA("TextBox"),"Decorative gradients must not tint text controls")
    -- UIGradient MULTIPLIES the underlying color; keep owned fills white.
    -- Automatic surface recoloring must not turn these fills dark again.
    if item:IsA("GuiObject") then
        item.BackgroundColor3=Color3.new(1,1,1)
        for i=#surfaceBindings,1,-1 do
            local b=surfaceBindings[i]
            if b.item==item and b.property=="BackgroundColor3" then table.remove(surfaceBindings,i) end
        end
    end
    local gradient=make("UIGradient",{Color=paletteSequence(mode,phase or 0),Rotation=mode=="shell" and 45 or 12},item)
    gradientBindings[#gradientBindings+1]={item=item,gradient=gradient,mode=mode,phase=phase or 0}
    return gradient
end
local function updatePalette(time)
    for _,b in ipairs(gradientBindings) do
        if b.gradient.Parent and b.item:IsDescendantOf(gui) then
            local phase=time*0.025+b.phase
            b.gradient.Color=paletteSequence(b.mode,phase)
            b.gradient.Offset=Vector2.new(math.sin(time*0.23+b.phase*6)*0.24,math.cos(time*0.17+b.phase*6)*0.12)
        end
    end
end
local function bindAccent(item, property, secondary)
    themeBindings[#themeBindings+1] = {item=item, property=property, secondary=secondary}
    item[property] = THEMES[config.settings.theme][secondary and "secondary" or "accent"]
end
local function setVisual(item,properties)
    if not alive or not item.Parent then return end
    for property,value in pairs(properties) do item[property]=value end
end
