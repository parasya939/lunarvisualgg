function cleanup()
    if not alive then return end
    stopGuide("SOLARA unloaded")
    if saveThread then pcall(task.cancel,saveThread); saveThread=nil end
    if config.settings.autoSave then
        local ok,err=pcall(saveLocal)
        if not ok then warn("SOLARA could not save local settings: "..tostring(err)) end
    end
    alive=false; pickTarget=nil; captureKey=nil; drag=nil
    for c in pairs(connections) do c:Disconnect() end; connections={}
    if markerFolder.Parent then markerFolder:Destroy() end
    if pageCache.Parent then pageCache:Destroy() end
    if gui.Parent then gui:Destroy() end
    logs={}; toastRecords={}; themeBindings={}; surfaceBindings={}; gradientBindings={}; profiles={}
end
connect(shutdown.Event,cleanup)
connect(gui.Destroying,cleanup)
connect(script.Destroying,cleanup)

