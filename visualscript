-- Input dispatcher: one connection; respects text input and UI ownership ----
connect(UIS.InputBegan,protect("Input",function(input,processed)
    if input.UserInputType==Enum.UserInputType.Keyboard then
        if captureKey then
            local chosen=input.KeyCode.Name
            if chosen=="Escape" then captureKey=nil; refreshSettings(); return end
            local key=captureKey
            keyName(chosen)
            assert(chosen~=config.settings[key=="toggleKey" and "stopKey" or "toggleKey"],"That key is assigned to the other hotkey")
            config.settings[key]=chosen; captureKey=nil; refreshSettings(); changed(); log("SYSTEM","Rebound "..key.." to "..chosen)
            return
        end
        if input.KeyCode.Name==config.settings.stopKey then
            stopGuide("Immediate stop hotkey; pending actions cancelled")
            pickTarget=nil; notify("Guide stopped","No pending guide actions remain."); return
        end
        if input.KeyCode==Enum.KeyCode.Escape then
            if pickTarget then pickTarget=nil; notify("Picker cancelled","Unit coordinates were kept.") end
            if modal then closeModal() end
            return
        end
        if UIS:GetFocusedTextBox() or processed then return end
        if input.KeyCode.Name==config.settings.toggleKey then
            root.Visible=not root.Visible; drag=nil
            if not root.Visible then closeModal(); pickTarget=nil end
        end
        return
    end
    if not pickTarget or processed then return end
    if input.UserInputType~=Enum.UserInputType.MouseButton1 and input.UserInputType~=Enum.UserInputType.Touch then return end
    local pos=Vector2.new(input.Position.X,input.Position.Y)
    for _,obj in ipairs(playerGui:GetGuiObjectsAtPosition(pos.X,pos.Y)) do
        if obj:IsDescendantOf(root) or obj:IsDescendantOf(toastHost) then return end
    end
    local camera=Workspace.CurrentCamera; assert(camera,"No active camera for raycast")
    local inset=game:GetService("GuiService"):GetGuiInset()
    local ray=camera:ViewportPointToRay(pos.X-inset.X,pos.Y-inset.Y)
    local params=RaycastParams.new()
    params.FilterType=Enum.RaycastFilterType.Exclude
    local excluded={markerFolder}; if player.Character then excluded[#excluded+1]=player.Character end
    params.FilterDescendantsInstances=excluded
    local result=Workspace:Raycast(ray.Origin,ray.Direction*2000,params)
    if not result then notify("No geometry hit","Click a visible surface, or enter coordinates in the editor."); return end
    local u=pickTarget; pickTarget=nil
    assert(table.find(config.units,u),"The selected unit was removed")
    u.x,u.y,u.z=result.Position.X,result.Position.Y,result.Position.Z
    refreshUnits(); changed(); log("UNIT",string.format("Picked %s position: %.1f, %.1f, %.1f",u.name,u.x,u.y,u.z))
    notify("Position saved",u.name.." now uses the selected world position.")
end))

