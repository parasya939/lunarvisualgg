local function log(category, message)
    if category == "ERROR" then sessionErrors += 1 end
    logs[#logs + 1] = {time = os.date("%H:%M:%S"), category = category, message = tostring(message):sub(1, 1200)}
    if #logs > 180 then table.remove(logs, 1) end
    logsDirty = true
end
local function protect(label, fn)
    return function(...)
        if not alive then return end
        local args = table.pack(...)
        local ok, err = xpcall(function() fn(table.unpack(args, 1, args.n)) end, debug.traceback)
        if not ok then
            log("ERROR", label .. ": " .. tostring(err))
            if notify then notify("Action failed", tostring(err):match("^[^\n]+") or "See LOGS for details", "error") end
        end
    end
end
local function saveLocal()
    local bundle = {config = config, profiles = profiles, activeProfile = activeProfile}
    local encoded = HttpService:JSONEncode(bundle)
    assert(#encoded <= 120000, "Session configuration exceeds 120 KB; reduce profiles/actions")
    player:SetAttribute(ATTRIBUTE, encoded)
end
local function changed()
    if saveThread then pcall(task.cancel, saveThread); saveThread = nil end
    if not config.settings.autoSave or not alive then return end
    saveThread = task.delay(0.4, function()
        saveThread = nil
        if alive then protect("Local autosave", saveLocal)() end
    end)
end
